# macOS
.DS_Store

# 构建产物
build/
DerivedData/
.build/
.swiftpm/
*.xcarchive
*.dmg
*.profraw

# Xcode 的个人状态（工程文件本身入库，由 project.yml 生成）
xcuserdata/
*.xcuserstate

# 签名与公证材料：只通过 Scripts/release/configure-github.sh 上传为 Secrets，绝不入库
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
.env
.env.*

# Python 缓存（发布脚本用到 dmgbuild）
__pycache__/
*.pyc

# 本机 AI 助手 / 编辑器的工作区配置，不入库
.spec-workflow/
.claude/
CLAUDE.local.md
.cursor/
.vscode/
.idea/
